---
import Base from "../layouts/Base.astro";
import Code from "../components/Code.astro";
import FinderDemo from "../components/FinderDemo.astro";
import ThemeGallery from "../components/ThemeGallery.astro";

const REPO = "https://github.com/jedipunkz/gm";

const features = [
  {
    title: "The finder is built in",
    body: "No ghq list | fzf | cd pipeline to assemble. The best match is the row at the bottom, next to the prompt, so the usual choice costs zero keystrokes.",
  },
  {
    title: "It ranks matches itself",
    body: "A fuzzy score first — a literal substring in the repository name beats letters scattered across the path — then frecency to break ties.",
  },
  {
    title: "The selection is described",
    body: "Path, remote, branch, working-tree status, visit count and the last three commits with their refs, so similar clones are easy to tell apart.",
  },
  {
    title: "Worktrees are first-class",
    body: "Ctrl-W swaps the list for the git worktrees of the repository under the cursor, Ctrl-L for its branches and Ctrl-J for its open pull requests: Enter checks one out as a worktree and goes there.",
  },
  {
    title: "One config file",
    body: "Roots, theme and key bindings live in gm.toml. $GHQ_ROOT and ghq.root are still honored, so an existing ghq tree needs no migration.",
  },
  {
    title: "gm create sets up origin",
    body: "A new repository gets git init and its origin remote in one step — something ghq leaves to you.",
  },
];

const keys = [
  ["any character", "Filter", "Filter", "Filter", "Filter"],
  ["↑ / Ctrl-P", "Move up", "Move up", "Move up", "Move up"],
  ["↓ / Ctrl-N", "Move down", "Move down", "Move down", "Move down"],
  ["Enter", "Print the repository path and exit", "Print the worktree path and exit", "Check the branch out as a worktree, print its path and exit", "Check the pull request out as a worktree, print its path and exit"],
  ["Ctrl-W", "Show the worktrees of the selected repository", "Back to the repositories", "Show the worktrees", "Show the worktrees"],
  ["Ctrl-L", "Show the branches of the selected repository", "Show the branches", "Back to the repositories", "Show the branches"],
  ["Ctrl-J", "Show the open pull requests of the selected repository", "Show the pull requests", "Show the pull requests", "Back to the repositories"],
  ["Ctrl-Alt-B", "Open the remote in a browser", "Open the remote in a browser", "Open the remote in a browser", "Open the remote in a browser"],
  ["Ctrl-G", "—", "Back to the repositories", "Back to the repositories", "Back to the repositories"],
  ["Esc", "Clear the query, then the filter, then quit", "Back to the repositories", "Back to the repositories", "Back to the repositories"],
  ["Ctrl-C", "Quit without printing", "Quit without printing", "Quit without printing", "Quit without printing"],
];

const slash = [
  ["/help", "Show the command list; q or Esc closes it"],
  ["/dirty", "Show only repositories with uncommitted work; Esc shows all"],
  ["/create <repo>", "Create a repository, after asking; adds it to the list"],
  ["/create <branch>", "In the worktree list: check that branch out as a worktree"],
  ["/get <repo>", "Same as gm get, then go to the clone"],
  ["/remove", "Remove the selected repository, or worktree, after asking"],
  ["/worktrees", "Same as Ctrl-W"],
  ["/branches", "Same as Ctrl-L"],
  ["/prs", "Same as Ctrl-J"],
  ["/remote", "Same as Ctrl-Alt-B"],
];

const subcommands = [
  ["gm", "Open the fuzzy finder; print the selected path"],
  ["gm get [-u] [-p] [--shallow] [-b <branch>] [-s] [-l] <repo>...", "Clone into the tree; -u updates an existing clone"],
  ["gm list [-p] [-e] [--unique] [<query>]", "List repositories (-p full paths, -e exact match, --unique shortest unambiguous name)"],
  ["gm status [--dirty] [--unpushed] [-a] [-p]", "List every repository and worktree with uncommitted or unpushed work; never fetches"],
  ["gm remove [--dry-run] [-y] <repo>...", "Remove a repository and its worktrees after confirming, pruning empty parents (gm rm also works)"],
  ["gm create [-p] <repo>", "Create and git init a repository with origin already set"],
  ["gm wt <create|remove> [-y] <repo> <branch>", "Add or remove a worktree from a script; the finder is better for doing it by hand"],
  ["gm migrate [--dry-run] [-y] [-r] <dir>...", "Move an existing clone into the tree, using its origin remote; -r searches the directory"],
  ["gm root [--all]", "Print the root directory"],
  ["gm shell <fish|zsh|bash>", "Print the Ctrl-G binding"],
  ["gm version", "Print the installed version"],
];

const rootOrder = ["$GM_ROOT", "root in gm.toml", "git config --get-all gm.root", "$GHQ_ROOT", "git config --get-all ghq.root", "~/ghq"];

const frecency = [
  ["within the last hour", "× 4"],
  ["within the last day", "× 2"],
  ["within the last week", "× 0.5"],
  ["older", "× 0.25"],
];

const chords = [
  ["ctrl-<letter>", "Everywhere"],
  ["ctrl-alt-<letter>", "Nearly everywhere: Alt is sent as an ESC prefix"],
  ["ctrl-shift-<letter>", "Only with the Kitty keyboard protocol — Ghostty, kitty, WezTerm, foot, recent Alacritty"],
];

const shells = [
  { name: "fish", file: "~/.config/fish/config.fish", line: "gm shell fish | source" },
  { name: "zsh", file: "~/.zshrc", line: 'eval "$(gm shell zsh)"' },
  { name: "bash", file: "~/.bashrc", line: 'eval "$(gm shell bash)"' },
];

const toml = `root         = "~/ghq"         # or ["~/ghq", "~/src"], searched in order
theme        = "tokyonight"
launch_key   = "ctrl-g"        # the shell key that opens gm
worktree_key = "ctrl-w"        # the finder key that lists worktrees
branch_key   = "ctrl-l"        # the finder key that lists branches
pr_key       = "ctrl-j"        # the finder key that lists pull requests
remote_key   = "ctrl-alt-b"    # the finder key that opens the remote`;

const layout = `~/gm/github.com/jedipunkz/gm/            the repository
~/gm/.worktrees/github.com/jedipunkz/gm/feat/login`;
---

<Base
  title="gm — jump to any repository"
  description="A ghq-style repository manager with a built-in fuzzy finder, frecency ranking and first-class git worktrees."
>
  <header class="nav">
    <div class="container nav-inner">
      <a class="logo" href="#top" aria-label="gm home"><span class="logo-mark">❯</span>gm</a>
      <nav aria-label="Sections">
        <a href="#features">Features</a>
        <a href="#install">Install</a>
        <a href="#usage">Usage</a>
        <a href="#config">Config</a>
        <a href="#ranking">Ranking</a>
      </nav>
      <a class="gh" href={REPO} aria-label="gm on GitHub">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
        <span>GitHub</span>
      </a>
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <div class="container">
        <p class="eyebrow">ghq-style repository manager · built-in fuzzy finder</p>
        <h1>Jump to any repository.<br /><span class="grad">Or any of its worktrees.</span></h1>
        <p class="lead hero-lead">
          <code>gm</code> clones into one predictable <code>host/user/repo</code> tree, and <kbd>Ctrl</kbd>+<kbd>G</kbd>{" "}
          takes you to any of them — ranked by how well they match and how often you go there.
        </p>
        <div class="cta">
          <div class="install-pill">
            <span class="dollar" aria-hidden="true">$</span>
            <code>brew install jedipunkz/gm/gm</code>
            <button type="button" class="pill-copy" data-copy="brew install jedipunkz/gm/gm">Copy</button>
          </div>
          <a class="btn" href={REPO}>View on GitHub →</a>
        </div>

        <div class="demo">
          <FinderDemo />
          <p class="demo-note">
            Live demo with sample data — type to filter, <kbd>↑</kbd><kbd>↓</kbd> to move, <kbd>Enter</kbd> to jump,
            <code>/help</code> for commands, and click <span class="u">ctrl-w</span> for worktrees. The ranking is the same
            algorithm gm uses.
          </p>
        </div>
      </div>
    </section>

    <section class="block" id="features">
      <div class="container">
        <p class="eyebrow">Why gm</p>
        <h2 class="section-title">What it does beyond ghq</h2>
        <p class="lead">An existing ghq tree works untouched. gm adds the parts you would otherwise glue together yourself.</p>
        <div class="grid features">
          {
            features.map((f, i) => (
              <article class="feature">
                <span class="num">{String(i + 1).padStart(2, "0")}</span>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </article>
            ))
          }
        </div>
        <p class="aside">
          Not implemented, deliberately: Mercurial / Subversion / Darcs cloning (they are still listed), bare clones, partial
          clones, parallel import, <code>--vcs</code>, and per-URL <code>ghq.&lt;url&gt;.root</code> roots.
        </p>
      </div>
    </section>

    <section class="block" id="install">
      <div class="container">
        <p class="eyebrow">Get started</p>
        <h2 class="section-title">Install in three steps</h2>
        <ol class="steps">
          <li>
            <div class="step-head"><span class="step-n">1</span><h3>Install the binary</h3></div>
            <p class="step-text">Homebrew on macOS or Linux downloads a prebuilt binary; no Go needed.</p>
            <Code code="brew install jedipunkz/gm/gm" />
            <p class="step-text">Or build from source with Go 1.25 or newer:</p>
            <Code code="go install github.com/jedipunkz/gm@latest" />
          </li>
          <li>
            <div class="step-head"><span class="step-n">2</span><h3>Bind it to your shell</h3></div>
            <p class="step-text">
              <code>gm</code> prints the chosen path, so it composes with <code>$(...)</code>. One line in your rc file turns
              that into a <code>cd</code> on <kbd>Ctrl</kbd>+<kbd>G</kbd>.
            </p>
            <div class="shells">
              {shells.map((s) => <Code code={s.line} label={`${s.name} — ${s.file}`} />)}
            </div>
          </li>
          <li>
            <div class="step-head"><span class="step-n">3</span><h3>Clone and jump</h3></div>
            <p class="step-text">
              Clones land under the root; press <kbd>Ctrl</kbd>+<kbd>G</kbd> anywhere to jump.
            </p>
            <Code code={"gm get jedipunkz/gm\n# then press Ctrl-G and type gm"} copy="gm get jedipunkz/gm" />
          </li>
        </ol>
        <p class="aside">
          Requirements: <code>git</code> on <code>$PATH</code>, and a true-color terminal for the themes to look as intended.
          <code>gm version</code> says which version you have.
        </p>
      </div>
    </section>

    <section class="block" id="usage">
      <div class="container">
        <p class="eyebrow">Usage</p>
        <h2 class="section-title">Keys</h2>
        <p class="lead">
          <kbd>Ctrl</kbd>+<kbd>W</kbd> swaps the repository list for the git worktrees of the repository under the cursor, and
          <kbd>Ctrl</kbd>+<kbd>L</kbd> for its branches; the same key swaps it back. Going back keeps the query, the cursor
          and the highlights as they were. The branch list holds the local branches and the remote ones with no local
          namesake, as the last fetch left them. <kbd>Enter</kbd> on a branch goes to its worktree, making one first when
          there is none — a remote branch becomes a local one that tracks it.
          <kbd>Ctrl</kbd>+<kbd>J</kbd> lists the open pull requests, drafts marked, through the
          <a href="https://cli.github.com/">GitHub CLI</a>; <kbd>Enter</kbd> has <code>gh pr checkout --worktree</code> make
          the worktree.
        </p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Key</th><th>Repository list</th><th>Worktree list</th><th>Branch list</th><th>Pull request list</th></tr></thead>
            <tbody>
              {keys.map(([k, a, b, c, d]) => <tr><td><kbd>{k}</kbd></td><td>{a}</td><td>{b}</td><td>{c}</td><td>{d}</td></tr>)}
            </tbody>
          </table>
        </div>
        <p class="aside">
          Everything else is ordinary text editing (<kbd>Ctrl-A</kbd>, <kbd>Ctrl-E</kbd>, <kbd>Ctrl-U</kbd>…), except
          <kbd>Ctrl-W</kbd>, which no longer deletes the word before the cursor. <kbd>Esc</kbd> undoes one layer of
          narrowing at a time — the worktree list, then the query, then the filter — and only quits once there is nothing
          left to undo.
        </p>

        <h2 class="section-title sub">Slash commands</h2>
        <p class="lead">
          A <code>/</code> at the start of the input types a command instead of a filter; <kbd>Tab</kbd> completes it.
          To act on a repository you just searched for, end the query with <code>;</code> and type the command after
          it: <code>gm;/remove</code> selects <code>gm</code> and removes it.
          <code>/create</code> and <code>/remove</code> ask first, in a panel over the list, and do the work without
          leaving the finder.
        </p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Command</th><th>What it does</th></tr></thead>
            <tbody>
              {slash.map(([c, w]) => <tr><td><code>{c}</code></td><td>{w}</td></tr>)}
            </tbody>
          </table>
        </div>

        <div class="split">
          <div>
            <h3 class="h3">Worktrees go where gm decides</h3>
            <p class="muted">
              The branch name is the only thing to type. <code>/create &lt;branch&gt;</code> starts the branch from
              <code>HEAD</code> if it does not exist yet. The leading dot keeps worktrees out of the repository list: the walk
              never descends into a dotted directory. The main worktree cannot be removed from the worktree list.
            </p>
          </div>
          <Code code={layout} />
        </div>

        <h2 class="section-title sub">Subcommands</h2>
        <p class="lead">
          <code>&lt;repo&gt;</code> accepts a full URL, <code>git@host:user/repo.git</code>, <code>host/user/repo</code>,
          <code>user/repo</code>, or a bare <code>repo</code> (resolved against <code>git config github.user</code>).
        </p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Command</th><th>What it does</th></tr></thead>
            <tbody>
              {subcommands.map(([c, w]) => <tr><td><code>{c}</code></td><td>{w}</td></tr>)}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="block" id="config">
      <div class="container">
        <p class="eyebrow">Configuration</p>
        <h2 class="section-title">One optional file</h2>
        <p class="lead">
          <code>~/.config/gm/gm.toml</code> (or <code>$XDG_CONFIG_HOME/gm/gm.toml</code>). A file that cannot be parsed, or
          that holds a key gm does not know, is an error rather than a file half ignored.
        </p>
        <div class="split">
          <Code code={toml} label="gm.toml" />
          <div>
            <h3 class="h3">Root resolution order</h3>
            <p class="muted">The first one set wins, so an existing ghq tree works untouched.</p>
            <ol class="order">
              {rootOrder.map((r) => <li><code>{r}</code></li>)}
            </ol>
          </div>
        </div>

        <h3 class="h3 top">Key bindings</h3>
        <p class="muted narrow">
          <code>launch_key</code> is the chord <code>gm shell</code> binds and must be a plain Ctrl chord;
          <code>worktree_key</code>, <code>branch_key</code>, <code>pr_key</code> and <code>remote_key</code> are the finder's own and also take <code>alt</code> and
          <code>shift</code>. Ctrl is written <code>ctrl-</code>, <code>ctrl+</code>, <code>c-</code> or <code>^</code>. After
          changing <code>launch_key</code>, re-run <code>gm shell &lt;shell&gt;</code>.
        </p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Chord</th><th>Reaches gm</th></tr></thead>
            <tbody>
              {chords.map(([c, w]) => <tr><td><code>{c}</code></td><td>{w}</td></tr>)}
            </tbody>
          </table>
        </div>

        <h3 class="h3 top" id="themes">Themes</h3>
        <p class="muted narrow">
          Set <code>theme</code> in <code>gm.toml</code>. An unknown name is an error listing the valid ones. The palettes
          below are read from gm's source when this site is built.
        </p>
        <ThemeGallery />
      </div>
    </section>

    <section class="block" id="ranking">
      <div class="container">
        <p class="eyebrow">Ranking</p>
        <h2 class="section-title">Match quality first, frecency second</h2>
        <div class="split">
          <div>
            <p class="muted">
              Typing filters by fuzzy match, scored so that a literal substring beats a subsequence pieced together from
              elsewhere, and the repository name counts for more than the user name. The host is shared by nearly every
              repository, so matches there cost points instead of earning them.
            </p>
            <p class="muted">
              Frecency only breaks ties between equally good matches. Visits are recorded in
              <code>$XDG_STATE_HOME/gm/frecency.json</code> (default <code>~/.local/state/gm/frecency.json</code>); delete it to
              start over.
            </p>
          </div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Last visit</th><th>Score = visits</th></tr></thead>
              <tbody>
                {frecency.map(([a, b]) => <tr><td>{a}</td><td><code>{b}</code></td></tr>)}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <span><span class="logo-mark">❯</span> gm · MIT License</span>
      <span>
        <a href={REPO}>Source</a> · <a href={`${REPO}/releases`}>Releases</a> ·
        <a href="https://github.com/jedipunkz/homebrew-gm">Homebrew tap</a>
      </span>
    </div>
  </footer>
</Base>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>(".pill-copy")) {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        btn.textContent = "Copied";
      } catch {
        btn.textContent = "Failed";
      }
      setTimeout(() => (btn.textContent = "Copy"), 1500);
    });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: saturate(160%) blur(12px);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 60px;
  }
  .logo {
    font: 700 1.15rem var(--font-mono);
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .logo:hover {
    text-decoration: none;
  }
  .logo-mark {
    color: var(--accent);
    font-family: var(--font-mono);
  }
  nav {
    display: flex;
    gap: 22px;
    margin-left: auto;
    font-size: 0.9rem;
  }
  nav a {
    color: var(--muted);
  }
  nav a:hover {
    color: var(--text);
    text-decoration: none;
  }
  .gh {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text);
    font-size: 0.88rem;
    border: 1px solid var(--line);
    border-radius: 99px;
    padding: 5px 12px;
  }
  .gh:hover {
    text-decoration: none;
    border-color: var(--faint);
  }
  @media (max-width: 720px) {
    nav {
      display: none;
    }
    .gh {
      margin-left: auto;
    }
  }

  .hero {
    padding: 80px 0 40px;
    text-align: center;
    background:
      radial-gradient(60% 50% at 50% 0%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%),
      var(--bg);
  }
  .hero h1 {
    font-size: clamp(2.3rem, 6vw, 4.1rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    margin-bottom: 20px;
  }
  .grad {
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-lead {
    margin: 0 auto;
  }
  .cta {
    margin: 32px 0 52px;
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .install-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 6px 6px 6px 16px;
    max-width: 100%;
  }
  .install-pill code {
    background: none;
    border: 0;
    padding: 0;
    font-size: 0.92rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .dollar {
    color: var(--faint);
    font-family: var(--font-mono);
  }
  .pill-copy,
  .btn {
    font: 600 0.85rem var(--font-sans);
    border-radius: 9px;
    padding: 8px 14px;
    cursor: pointer;
  }
  .pill-copy {
    color: var(--bg);
    background: var(--text);
    border: 0;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    color: var(--text);
    border: 1px solid var(--line);
    background: transparent;
    padding: 12px 18px;
  }
  .btn:hover {
    text-decoration: none;
    border-color: var(--faint);
  }
  .demo {
    max-width: 980px;
    margin: 0 auto;
  }
  .demo-note {
    margin-top: 16px;
    color: var(--faint);
    font-size: 0.85rem;
  }
  .demo-note kbd {
    font-size: 0.75rem;
    margin: 0 1px;
  }
  .u {
    font-family: var(--font-mono);
    text-decoration: underline dotted;
    text-underline-offset: 3px;
  }

  .grid.features {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
    margin-top: 40px;
  }
  @media (max-width: 400px) {
    .grid.features {
      grid-template-columns: 1fr;
    }
  }
  .feature {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .feature:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
    transform: translateY(-2px);
  }
  .num {
    font: 600 0.78rem var(--font-mono);
    color: var(--accent);
  }
  .feature h3 {
