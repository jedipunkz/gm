---
// The reference, ordered by what a reader comes looking for: a task first,
// then the finder they use every day, then the commands, where things go, and
// what can be configured. The home page shows what gm is; this page answers
// how to do a given thing with it.
import Base from "../layouts/Base.astro";
import Code from "../components/Code.astro";
import RefTable from "../components/RefTable.astro";
import { loadThemes } from "../lib/themes";

const themes = loadThemes();
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const toc = [
  ["tasks", "Common tasks", []],
  ["finder", "Finder", [
    ["lists", "Lists"],
    ["keys", "Keys"],
    ["slash", "Slash commands"],
    ["editing", "Text editing"],
  ]],
  ["commands", "Commands", [
    ["cmd-get", "gm get"],
    ["cmd-list", "gm list"],
    ["cmd-status", "gm status"],
    ["cmd-create", "gm create"],
    ["cmd-remove", "gm remove"],
    ["cmd-wt", "gm wt"],
    ["cmd-migrate", "gm migrate"],
    ["cmd-other", "gm root / shell / version"],
    ["scripting", "Scripting"],
  ]],
  ["layout", "Where repositories go", [
    ["refs", "Repository references"],
    ["tree", "Directory layout"],
  ]],
  ["config", "Configuration", [
    ["settings", "gm.toml"],
    ["root", "Roots"],
    ["chords", "Key bindings"],
    ["themes", "Themes"],
  ]],
  ["ranking", "Ranking", []],
  ["env", "Requirements and environment", []],
] as const;

const tasks = [
  ["Jump to a repository", "`Ctrl-G` in the shell, type part of its name, `Enter`"],
  ["Clone a repository", "`gm get user/repo`, or `/get user/repo` in the finder"],
  ["Update a clone", "`gm get -u <repo>`: fetches, then fast-forwards only if the tree is clean"],
  ["Work on a branch in its own worktree", "Finder: `Ctrl-L`, pick the branch, `Enter`. New branch: `/create <branch>`"],
  ["Check out a pull request", "Finder: `Ctrl-J`, pick it, `Enter` (needs `gh`)"],
  ["Find uncommitted or unpushed work", "`gm status`, or `/dirty` `/unpushed` in the finder"],
  ["Clean up old worktrees", "`/expire 30d` in the worktree list, or `gm wt expire <repo> 30d`"],
  ["Remove a repository", "`gm remove <repo>`, or `/remove` in the finder"],
  ["Start a new repository", "`gm create <repo>`, or `/create <repo>` in the finder"],
  ["Move existing clones into the tree", "`gm migrate -r ~/src` (try `--dry-run` first)"],
  ["Open the remote in a browser", "`Ctrl-Alt-B`, or `/browse`"],
];

const lists = [
  ["Repositories", "`Ctrl-G` in the shell, or `gm`", "Every repository under every root", "Go there"],
  ["Worktrees", "`Ctrl-W`", "Worktrees of the selected repository", "Go there"],
  ["Branches", "`Ctrl-L`", "Local branches, and remote ones with no local branch", "Go to its worktree, creating it if needed"],
  ["Pull requests", "`Ctrl-J`", "Open pull requests, drafts marked `[draft]`", "Go to its worktree, creating it with `gh pr checkout --worktree` if needed"],
];

const keys = [
  ["type", "Filter the list"],
  ["`↑` `↓` / `Ctrl-P` `Ctrl-N`", "Move the cursor; `PgUp` `PgDn` move a screen"],
  ["`Enter`", "Go to the selected row (gm prints its path and the shell `cd`s there). With a command typed, run it"],
  ["`Ctrl-W` `Ctrl-L` `Ctrl-J`", "Open the worktree / branch / pull request list. The same key goes back to the repositories"],
  ["`Ctrl-Alt-B`", "Open the repository's remote in a browser"],
  ["`Tab`", "Accept the command completion shown after the cursor"],
  ["`Esc`", "Undo one step: back to the repositories, clear the query, clear `/dirty` `/unpushed`, then quit"],
  ["`Ctrl-G`", "Same as `Esc`, but never quits"],
  ["`Ctrl-C`", "Quit at once"],
];

const slash = [
  ["`/get [flags] <repo>`", "Clone (runs `gm get`) and go to it", "All"],
  ["`/create <repo>`", "Create a new repository with `origin` set", "Repositories"],
  ["`/create <branch>`", "Check the branch out as a worktree; a new branch starts from `HEAD`", "Worktrees, branches, PRs"],
  ["`/remove`", "Remove the selected repository with its worktrees, or the selected worktree and its merged branch. Never the main worktree", "Repositories, worktrees"],
  ["`/expire <days>d`", "Remove worktrees whose `HEAD` has not moved for that long, and their merged branches", "Worktrees"],
  ["`/dirty` `/unpushed`", "Toggle a filter: only repositories with uncommitted changes / unpushed commits. Both on: both must hold", "Repositories"],
  ["`/worktrees` `/branches` `/prs` `/browse`", "Same as `Ctrl-W` `Ctrl-L` `Ctrl-J` `Ctrl-Alt-B`", "All"],
  ["`/help`", "Show the command list", "All"],
];

const editing = [
  ["`Ctrl-A` `Ctrl-E` / `Home` `End`", "Start / end of the line"],
  ["`Ctrl-B` `Ctrl-F` / `←` `→`", "One character"],
  ["`Alt-B` `Alt-F` / `Ctrl-←` `Ctrl-→`", "One word"],
  ["`Ctrl-H` `Ctrl-D` / `Backspace` `Delete`", "Delete a character before / at the cursor"],
  ["`Alt-Backspace`, `Alt-D`", "Delete a word before / after the cursor"],
  ["`Ctrl-U`, `Ctrl-K`", "Delete to the start / end"],
];

const commands = [
  ["`gm`", "Open the finder; print the chosen path"],
  ["`gm get <repo>...`", "Clone (alias `clone`)"],
  ["`gm list [<query>]`", "Print repositories (alias `ls`)"],
  ["`gm status`", "List uncommitted and unpushed work"],
  ["`gm create <repo>`", "Start a new repository (alias `new`)"],
  ["`gm remove <repo>...`", "Remove repositories and their worktrees (alias `rm`)"],
  ["`gm wt create|remove|expire`", "Manage worktrees from scripts"],
  ["`gm migrate <dir>...`", "Move existing clones into the tree"],
  ["`gm root [--all]`", "Print the root(s)"],
  ["`gm shell <fish|zsh|bash>`", "Print the shell key binding"],
  ["`gm version`, `gm help`", "Version, usage. `-h` after a subcommand lists its flags"],
];

const getFlags = [
  ["`-u`, `--update`", "Update a repository already cloned instead of skipping it"],
  ["`--ssh`", "Clone over SSH"],
  ["`--shallow`", "`git clone --depth 1`"],
  ["`-b <branch>`", "Clone that branch only"],
  ["`--no-recursive`", "Skip submodules (cloned by default)"],
  ["`-s`, `--silent`", "Quiet `git clone`"],
  ["`-l`, `--look`", "Afterwards, start a shell inside the repository"],
];

const statusFlags = [
  ["`--dirty`", "Only rows with uncommitted changes"],
  ["`--unpushed`", "Only rows with unpushed commits (with `--dirty`: both)"],
  ["`-a`", "Also rows that are clean and in sync"],
  ["`-p`, `--full-path`", "Absolute paths"],
];

const dryYes = [
  ["`--dry-run`", "Show what would happen, change nothing"],
  ["`-y`", "Do not ask for confirmation"],
];

const wt = [
  ["`gm wt create <repo> <branch>`", "Check the branch out as a worktree (new branches start from `HEAD`); prints its path"],
  ["`gm wt remove <repo> <branch>`", "Remove that worktree, then its branch if merged. Never the main worktree"],
  ["`gm wt expire <repo> <days>d`", "Remove worktrees whose `HEAD` has not moved for that many days, and their merged branches. Ones with uncommitted changes are kept"],
];

const refs = [
  ["`https://github.com/u/r`", "`github.com/u/r`"],
  ["`git@github.com:u/r.git`", "`github.com/u/r`"],
  ["`example.com/u/r`", "`example.com/u/r` (over https)"],
  ["`u/r`", "`github.com/u/r`"],
  ["`r`", "`github.com/<you>/r`: `git config github.user`, else `$USER`"],
];

const settings = [
  ["`root`", "`~/ghq`", "Where repositories live; a list is searched in order, the first gets new clones"],
  ["`theme`", "`tokyonight`", "The finder's colors"],
  ["`launch_key`", "`ctrl-g`", "The shell key that opens gm"],
  ["`worktree_key`", "`ctrl-w`", "Finder: worktree list"],
  ["`branch_key`", "`ctrl-l`", "Finder: branch list"],
  ["`pr_key`", "`ctrl-j`", "Finder: pull request list"],
  ["`remote_key`", "`ctrl-alt-b`", "Finder: open the remote in a browser"],
];

const toml = `root         = "~/ghq"         # or ["~/ghq", "~/src"], searched in order
theme        = "tokyonight"
launch_key   = "ctrl-g"
worktree_key = "ctrl-w"
branch_key   = "ctrl-l"
pr_key       = "ctrl-j"
remote_key   = "ctrl-alt-b"`;

const rootOrder = [
  ["1", "`$GM_ROOT` (colon-separated)"],
  ["2", "`root` in `gm.toml`"],
  ["3", "`git config gm.root` (every value)"],
  ["4", "`$GHQ_ROOT` (colon-separated)"],
  ["5", "`git config ghq.root` (every value)"],
  ["6", "`~/ghq`"],
];

const reach = [
  ["`ctrl-<letter>`", "Every terminal"],
  ["`ctrl-alt-<letter>`", "Nearly every terminal"],
  ["`ctrl-shift-<letter>`", "Only terminals with the Kitty keyboard protocol (Ghostty, kitty, WezTerm, foot, recent Alacritty); elsewhere it arrives as `ctrl-<letter>`"],
];

const files = [
  ["`~/.config/gm/gm.toml`", "Settings (`$XDG_CONFIG_HOME/gm/` if set). Optional"],
  ["`~/.local/state/gm/frecency.json`", "Visit log (`$XDG_STATE_HOME/gm/` if set). Delete it to reset the ranking"],
  ["`<root>/.worktrees/`", "Worktrees"],
];

const envs = [
  ["`GM_ROOT`", "Roots, colon-separated; overrides every other setting"],
  ["`GHQ_ROOT`", "Roots, colon-separated; used when gm has no setting of its own"],
  ["`XDG_CONFIG_HOME`, `XDG_STATE_HOME`", "Where `gm.toml` and the visit log live"],
  ["`GM_LOOK`", "Set by `gm get -l` in the shell it starts: the repository's path"],
];
---

<Base
  title="gm docs — reference"
  description="Reference for gm: common tasks, finder keys and slash commands, subcommands, where repositories go, gm.toml settings and environment."
  current="docs"
>
  <main class="container docs">
    <aside class="toc" aria-label="On this page">
      <p class="toc-title">Reference</p>
      <ol>
        {
          toc.map(([id, name, sub]) => (
            <li>
              <a href={`#${id}`}>{name}</a>
              {sub.length > 0 && (
                <ol>
                  {sub.map(([sid, sname]) => (
                    <li>
                      <a href={`#${sid}`}>{sname}</a>
                    </li>
                  ))}
                </ol>
              )}
            </li>
          ))
        }
      </ol>
    </aside>

    <article class="doc">
      <p class="eyebrow">Docs</p>
      <h1>Reference</h1>
      <p class="lead">
        How to do things with gm, and what each command, key and setting does. To install it, see
        <a href={`${base}#install`}>Install</a>.
      </p>

      <h2 id="tasks">Common tasks</h2>
      <RefTable head={["To", "Do"]} rows={tasks} />

      <h2 id="finder">Finder</h2>
      <p>
        <code>Ctrl-G</code> in the shell (after <a href="#cmd-other"><code>gm shell</code></a>) or <code>gm</code> opens it.
        The best match is the bottom row, next to the prompt; details of the selected row are on the right. While gm waits on
        git or GitHub, the line under the prompt says what it is waiting on.
      </p>

      <h3 id="lists">Lists</h3>
      <RefTable head={["List", "Open with", "Shows", "Enter"]} rows={lists} />
      <ul>
        <li>The other lists belong to the repository selected when they were opened. Going back restores the query and cursor.</li>
        <li>In the pull request list, <code>#42</code> finds number 42.</li>
        <li>Picking a remote branch makes a local branch that tracks it.</li>
      </ul>

      <h3 id="keys">Keys</h3>
      <RefTable head={["Key", "Action"]} rows={keys} />
      <p><code>Ctrl-W</code> <code>Ctrl-L</code> <code>Ctrl-J</code> <code>Ctrl-Alt-B</code> can be changed: see <a href="#chords">Key bindings</a>.</p>

      <h3 id="slash">Slash commands</h3>
      <ul>
        <li>Type <code>/</code> in an empty box to start a command; <code>Tab</code> completes it, <code>Enter</code> runs it.</li>
        <li>To act on a search result, end the query with <code>;</code>: <code>gm;/remove</code> selects <code>gm</code> and removes it.</li>
        <li><code>/create</code>, <code>/remove</code> and <code>/expire</code> show what will happen, uncommitted changes included, and ask first: <code>y</code> goes ahead, <code>n</code> or <code>Esc</code> cancels.</li>
      </ul>
      <RefTable head={["Command", "Action", "Works in"]} rows={slash} />

      <h3 id="editing">Text editing</h3>
      <p>Emacs-style keys edit the query. Pasted text is inserted with newlines dropped.</p>
      <RefTable head={["Key", "Moves / deletes"]} rows={editing} />
      <p>
        <code>Ctrl-W</code> opens the worktree list instead of deleting a word; use <code>Alt-Backspace</code>, or move
        <code>worktree_key</code> elsewhere.
      </p>

      <h2 id="commands">Commands</h2>
      <RefTable head={["Command", "Does"]} rows={commands} />
      <p>
        <code>&lt;repo&gt;</code> to clone or create is a URL or a shorthand: see <a href="#refs">Repository references</a>.
        <code>remove</code> and <code>wt</code> take a query instead: an exact name, <code>user/repo</code> or
        <code>host/user/repo</code>, else a substring; more than one match is an error listing them.
      </p>

      <h3 id="cmd-get">gm get <code>[flags] &lt;repo&gt;...</code></h3>
      <p>Clones each repository under the first root, submodules included. One already cloned is skipped unless <code>-u</code> is given.</p>
      <RefTable head={["Flag", "Effect"]} rows={getFlags} />
      <p>
        <code>-u</code> fetches and fast-forwards the checked-out branch. It never merges: a dirty tree or a diverged branch
        is left alone, with a <code>skip</code> line saying why.
      </p>

      <h3 id="cmd-list">gm list <code>[flags] [&lt;query&gt;]</code></h3>
      <p>Prints <code>host/user/repo</code> for every repository whose path contains the query (case-sensitive).</p>
      <RefTable
        head={["Flag", "Effect"]}
        rows={[
          ["`-p`, `--full-path`", "Absolute paths"],
          ["`-e`, `--exact`", "The query must equal the name, `user/repo`, or `host/user/repo`"],
          ["`--unique`", "The shortest name no other repository shares: `gm`, else `jedipunkz/gm`, else the full path"],
        ]}
      />

      <h3 id="cmd-status">gm status <code>[flags]</code></h3>
      <p>
        Lists repositories and worktrees with uncommitted changes or unpushed commits, e.g.
        <code>3 changed files, 2 unpushed</code>. It never fetches, so it works offline; <code>behind</code> counts are as
        of the last fetch.
      </p>
      <RefTable head={["Flag", "Effect"]} rows={statusFlags} />

      <h3 id="cmd-create">gm create <code>[--ssh] &lt;repo&gt;</code></h3>
      <p>
        Makes the directory under the first root, runs <code>git init</code>, sets <code>origin</code> (SSH with
        <code>--ssh</code>), and prints the path. Refused if the repository already exists or the directory is not empty.
      </p>

      <h3 id="cmd-remove">gm remove <code>[--dry-run] [-y] &lt;repo&gt;...</code></h3>
      <p>
        Removes each repository and every worktree checked out of it. Before asking, it lists what would be lost:
        uncommitted changes in the repository and in each worktree.
      </p>
      <RefTable head={["Flag", "Effect"]} rows={dryYes} />

      <h3 id="cmd-wt">gm wt <code>create | remove | expire</code></h3>
      <p>The finder's worktree actions, for scripts. <code>remove</code> and <code>expire</code> take <code>--dry-run</code> and <code>-y</code>.</p>
      <RefTable head={["Command", "Effect"]} rows={wt} />

      <h3 id="cmd-migrate">gm migrate <code>[--dry-run] [-y] [-r] &lt;directory&gt;...</code></h3>
      <p>
        Moves existing clones to the path their <code>origin</code> says, asking for each, and repairs their worktrees.
        <code>-r</code> searches each directory for repositories instead and skips the ones it cannot move (no
        <code>origin</code>, destination exists, a worktree or submodule).
      </p>

      <h3 id="cmd-other">gm root / gm shell / gm version</h3>
      <ul>
        <li><code>gm root</code> prints the first root, where new repositories go; <code>--all</code> prints every root.</li>
        <li><code>gm shell &lt;fish|zsh|bash&gt;</code> prints the <code>launch_key</code> binding: it runs <code>gm</code> and <code>cd</code>s to the result. Re-run it after changing <code>launch_key</code>.</li>
        <li><code>gm version</code> prints the version; <code>gm help</code> the usage.</li>
      </ul>
      <RefTable
        head={["Shell", "Add to"]}
        rows={[
          ["fish", "`gm shell fish | source` in `~/.config/fish/config.fish`"],
          ["zsh", "`eval \"$(gm shell zsh)\"` in `~/.zshrc`"],
          ["bash", "`eval \"$(gm shell bash)\"` in `~/.bashrc`"],
        ]}
      />

      <h3 id="scripting">Scripting</h3>
      <ul>
        <li>Paths go to stdout (the finder's choice, <code>create</code>, <code>wt create</code>, <code>migrate</code>); progress, warnings and prompts go to stderr. <code>cd "$(gm)"</code> works.</li>
        <li>Exit status: <code>0</code> success (quitting the finder and answering no included), <code>1</code> error, <code>2</code> wrong usage.</li>
        <li>Prompts read <code>[y/N]</code>; a closed stdin answers no. Pass <code>-y</code> to skip them.</li>
        <li>Flags go before the arguments; <code>-b main</code> and <code>--branch=main</code> are the same.</li>
      </ul>

      <h2 id="layout">Where repositories go</h2>

      <h3 id="refs">Repository references</h3>
      <p>A <code>&lt;repo&gt;</code> to clone or create becomes a URL, and its <code>host/user/repo</code> is the directory under the root.</p>
      <RefTable head={["Written as", "Directory"]} rows={refs} />

      <h3 id="tree">Directory layout</h3>
      <Code
        code={`~/ghq/github.com/jedipunkz/gm/                            repository
~/ghq/.worktrees/github.com/jedipunkz/gm/feat/login       worktree of branch feat/login
~/ghq/.worktrees/github.com/jedipunkz/gm/.forks/bob/main  worktree of a pull request from bob's fork`}
      />
      <ul>
        <li>Worktrees live under <code>&lt;root&gt;/.worktrees/</code>. gm never looks inside dot-directories, so they are not listed as repositories.</li>
        <li>Mercurial and Subversion working copies are listed, but gm only clones with git.</li>
      </ul>

      <h2 id="config">Configuration</h2>

      <h3 id="settings">gm.toml</h3>
      <p>
        <code>~/.config/gm/gm.toml</code>, optional. Every key is optional too. A typo, an unknown key or a wrong type is an
        error naming the file, so a setting is never silently ignored.
      </p>
      <Code code={toml} label="gm.toml" />
      <RefTable head={["Key", "Default", "Meaning"]} rows={settings} />

      <h3 id="root">Roots</h3>
      <p>The first source that is set wins, so an existing ghq setup works untouched:</p>
      <RefTable head={["#", "Source"]} rows={rootOrder} />
      <p>
        <code>~</code> expands to your home directory; every root must be absolute. New clones go to the first root; all
        roots are listed and searched.
      </p>

      <h3 id="chords">Key bindings</h3>
      <p>
        Write a chord as Ctrl, optionally Alt and Shift, plus one letter: <code>ctrl-g</code>, <code>ctrl-alt-b</code>
        (<code>Ctrl+Alt+B</code>, <code>c-a-b</code> and <code>^b</code> also work). An invalid chord is an error.
      </p>
      <ul>
        <li><code>launch_key</code> must be a plain Ctrl chord, and not <code>ctrl-m</code> <code>ctrl-i</code> <code>ctrl-j</code> (terminals send them as Enter, Tab, newline).</li>
        <li>The four finder keys must differ from each other, and cannot take <code>ctrl-m</code> <code>ctrl-i</code> or, as plain chords, <code>ctrl-c</code> <code>ctrl-n</code> <code>ctrl-p</code> <code>ctrl-g</code>.</li>
        <li>Avoid what the shell keeps for itself: <code>ctrl-r</code>, <code>ctrl-c</code>, <code>ctrl-d</code>, <code>ctrl-z</code>.</li>
      </ul>
      <RefTable head={["Chord", "Works in"]} rows={reach} />

      <h3 id="themes">Themes</h3>
      <p>{themes.map((t, i) => <>{i > 0 && " "}<code>{t.name}</code></>)}</p>
      <p>The default is <code>tokyonight</code>. See the palettes on the <a href={`${base}#themes`}>home page</a>.</p>

      <h2 id="ranking">Ranking</h2>
      <ul>
        <li>Typing keeps repositories whose <code>host/user/repo</code> holds the typed characters in order, ignoring case.</li>
        <li>Better matches go lower: a literal substring beats scattered characters, and a match in the repository name counts more than one in the user name or host.</li>
        <li>Ties, and the list before you type, are ordered by frecency: how often and how recently you visited.</li>
        <li>A visit is choosing a row in the finder, or cloning, creating or moving a repository with gm.</li>
      </ul>

      <h2 id="env">Requirements and environment</h2>
      <ul>
        <li>macOS or Linux (WSL2 included), <code>git</code> on <code>$PATH</code>, and a true-color terminal for the themes.</li>
        <li>The pull request list needs <a href="https://cli.github.com/"><code>gh</code></a>, logged in. The branch list uses git's own credentials.</li>
        <li>Network calls never prompt for a password and give up after a deadline (20 s for the branch list, 30 s for pull requests), saying what timed out.</li>
      </ul>
      <RefTable head={["File", "Purpose"]} rows={files} />
      <RefTable head={["Variable", "Effect"]} rows={envs} />
    </article>
  </main>
</Base>

<style>
  .docs {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 48px;
    padding-top: 48px;
    padding-bottom: 96px;
  }
  @media (max-width: 900px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }
  .toc {
    position: sticky;
    top: 84px;
    align-self: start;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
    font-size: 0.88rem;
  }
  @media (max-width: 900px) {
    .toc {
      position: static;
      max-height: none;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface);
      padding: 16px 20px;
    }
  }
  .toc-title {
    font: 600 0.75rem var(--font-mono);
    color: var(--faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 10px;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc li {
    margin: 4px 0;
  }
  .toc ol ol {
    padding-left: 12px;
    border-left: 1px solid var(--line);
    margin: 4px 0 10px;
  }
  .toc a {
    color: var(--muted);
  }
  .toc a:hover {
    color: var(--text);
    text-decoration: none;
  }

  .doc {
    min-width: 0;
  }
  .doc h1 {
    font-size: clamp(2rem, 4.5vw, 2.8rem);
    letter-spacing: -0.03em;
    margin-bottom: 14px;
  }
  .doc h2 {
    font-size: 1.7rem;
    margin: 72px 0 18px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .doc h3 {
    font-size: 1.15rem;
    margin: 40px 0 12px;
  }
  .doc h3 code {
    font-size: 0.85em;
    color: var(--muted);
  }
  .doc p,
  .doc ul,
  .doc ol {
    color: var(--muted);
    max-width: 780px;
  }
  .doc > p,
  .doc > ul,
  .doc > ol {
    margin: 12px 0;
  }
  .doc ul,
