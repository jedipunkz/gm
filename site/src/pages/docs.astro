const toml = `root         = "~/ghq"         # or ["~/ghq", "~/src"], searched in order
theme        = "tokyonight"
launch_key   = "ctrl-g"
worktree_key = "ctrl-w"
branch_key   = "ctrl-l"
pr_key       = "ctrl-j"
remote_key   = "ctrl-alt-b"`;

const rootOrder = [
