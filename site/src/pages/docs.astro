// The reference: every command, flag, key, setting and file gm has, as the
// source in src/ implements them. The home page shows what gm is; this page
// answers what exactly a given piece of it does.
import Base from "../layouts/Base.astro";
import Code from "../components/Code.astro";
import RefTable from "../components/RefTable.astro";
import { loadThemes } from "../lib/themes";

const themes = loadThemes();
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const toc = [
  ["cli", "Command line", [
    ["synopsis", "Synopsis"],
    ["flags", "Flag syntax"],
    ["exit", "Exit status and output"],
  ]],
  ["commands", "Subcommands", [
    ["cmd-gm", "gm"],
    ["cmd-get", "gm get"],
    ["cmd-list", "gm list"],
    ["cmd-status", "gm status"],
    ["cmd-create", "gm create"],
    ["cmd-remove", "gm remove"],
    ["cmd-wt", "gm wt"],
    ["cmd-migrate", "gm migrate"],
    ["cmd-root", "gm root"],
    ["cmd-shell", "gm shell"],
    ["cmd-version", "gm version / help"],
  ]],
  ["refs", "Repository references", []],
  ["layout", "Directory layout", []],
  ["finder", "Finder", [
    ["lists", "Lists"],
    ["keys", "Keys"],
    ["editing", "Text editing"],
    ["slash", "Slash commands"],
    ["panels", "Panels"],
    ["details", "Details pane"],
    ["network", "Network calls"],
  ]],
  ["config", "Configuration", [
    ["settings", "Settings"],
    ["root", "Root resolution"],
    ["themes", "Themes"],
    ["chords", "Key bindings"],
  ]],
  ["ranking", "Ranking", []],
  ["files", "Files and environment", []],
] as const;

const synopsis = `gm                                   open the finder, print the chosen path
gm get [flags] <repo>...             alias: gm clone
gm list [flags] [<query>]            alias: gm ls
gm status [flags]
gm create [--ssh] <repo>             alias: gm new
gm remove [--dry-run] [-y] <repo>... alias: gm rm
gm wt create <repo> <branch>         alias: gm wt new
gm wt remove [--dry-run] [-y] <repo> <branch>     alias: gm wt rm
gm wt expire [--dry-run] [-y] <repo> <days>d
gm migrate [--dry-run] [-y] [-r] <directory>...
gm root [--all]
gm shell <fish|zsh|bash>
gm version | -v | --version
gm help | -h | --help`;

